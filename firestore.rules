rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  function isAuthenticated() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return isAuthenticated() && request.auth.uid == userId;
  }

  function userProfile() {
    return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
  }

  function hasActiveProfile() {
    return isAuthenticated()
      && exists(/databases/$(database)/documents/users/$(request.auth.uid))
      && (!userProfile().keys().hasAny(['disabled']) || userProfile().disabled == false)
      && (!userProfile().keys().hasAny(['status']) || userProfile().status != 'disabled');
  }

  function hasRole(role) {
    return hasActiveProfile()
      && userProfile().role == role;
  }

  // SEC-01 FIX: Use custom claims and exact email checks instead of wildcard substring matching.
  // This prevents any user with 'admin' or 'cenro' in their email from gaining admin access.
  function isAdmin() {
    return isAuthenticated() && (
      request.auth.token.get('admin', false) == true
      || request.auth.token.get('email', '') == 'admin@admin.com'
      || (hasActiveProfile() && (userProfile().role == 'admin' || userProfile().role == 'cenro'))
    );
  }

  function validAdminProfileCreate(userId) {
    return isOwner(userId)
      && (request.resource.data.role == 'admin' || request.resource.data.role == 'cenro')
      && (
        request.auth.token.get('admin', false) == true
        || request.auth.token.get('email', '') == 'admin@admin.com'
      );
  }

  // SEC-01 FIX: Use custom claims and exact email check instead of wildcard substring matching.
  function isCicto() {
    return isAuthenticated() && (
      request.auth.token.get('cicto', false) == true
      || request.auth.token.get('email', '') == 'cicto@trashtrack.gov.ph'
      || (hasActiveProfile() && userProfile().role == 'cicto')
    );
  }

  function validCictoProfileCreate(userId) {
    return isOwner(userId)
      && request.resource.data.role == 'cicto'
      && (
        request.auth.token.get('cicto', false) == true
        || request.auth.token.get('email', '') == 'cicto@trashtrack.gov.ph'
      );
  }

  function isAssignedDriver(schedule) {
    return hasRole('driver') && schedule.get('assignedDriverId', '') == request.auth.uid;
  }

  function driverCompletionUpdateOnly() {
    return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      'status',
      'completedAt',
      'completionImage',
      'completionImagePublicId',
      'completionDescription',
      'completionNotes',
      'completionLocation',
      'collectionMeasurement',
      'completedBy',
      'completedByEmail',
      'completedByUid',
      'completedByName',
      'issueReportedAt',
      'issueImage',
      'issueImagePublicId',
      'issueLocation',
      'issueDescription',
      'issueType',
      'reportedBy',
      'reportedByEmail',
      'reportedByUid',
      'reportedByName',
      'updatedAt',
      'street',
      'wasteCategory',
      'stops',
      'routeOptimization',
      'isLiveDispatch',
      'truckId',
      'truckPlate',
      'dieselClosedAt'
    ]);
  }

  function hasValidDriverEvidence() {
    return (
      request.resource.data.status == 'completed'
      && request.resource.data.completedByUid == request.auth.uid
      && request.resource.data.collectionMeasurement.value is number
      && request.resource.data.collectionMeasurement.value > 0
      && (request.resource.data.collectionMeasurement.unit in ['kg', 'ton', 'm3'])
      && (
        request.resource.data.collectionMeasurement.get('bagCount', null) == null
        || (
          request.resource.data.collectionMeasurement.get('bagCount', null) is int
          && request.resource.data.collectionMeasurement.get('bagCount', -1) >= 0
        )
      )
    ) || (
      request.resource.data.status == 'issue'
      && request.resource.data.reportedByUid == request.auth.uid
      && request.resource.data.issueDescription is string
      && request.resource.data.issueDescription.size() > 0
    );
  }

  function validResidentProfileCreate(userId) {
    return isOwner(userId)
      && request.resource.data.role == 'user'
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.email == request.auth.token.get('email', '')
      && request.resource.data.get('verified', false) == request.auth.token.get('email_verified', false)
      && request.resource.data.keys().hasOnly([
        'uid', 'email', 'displayName', 'name', 'firstName', 'lastName', 'middleInitial', 'photoURL', 'verified', 'role', 'provider',
        'barangay', 'contactInfo', 'phoneNumber', 'createdAt', 'updatedAt'
      ]);
  }

  function regularProfileUpdateOnly() {
    return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      'displayName', 'photoURL', 'barangay', 'barangayUpdatedAt', 'contactInfo', 'phoneNumber', 'phone',
      'firstName', 'lastName', 'middleInitial', 'name', 'gender', 'dateOfBirth', 'dob', 'verified',
      'provider', 'email', 'lastLogin', 'updatedAt', 'mustChangePassword', 'passwordChangeSnoozedUntil',
      'status', 'dutyStatus', 'currentTruckId', 'currentTruckPlate', 'assignedTruck', 'assignedBarangay',
      'currentShiftFuelBudgetLiters', 'unassignedNotice'
    ])
    && request.resource.data.get('role', '') == resource.data.get('role', '')
    && request.resource.data.get('uid', '') == resource.data.get('uid', '')
    && (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email'])
      || request.resource.data.get('email', '') == request.auth.token.get('email', '')
    )
    && (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified'])
      || request.resource.data.get('verified', false) == request.auth.token.get('email_verified', false)
      || resource.data.get('verified', false) == true
      || resource.data.get('role', '') in ['driver', 'admin', 'cenro', 'cicto', 'coordinator']
    );
  }

  function validRewardRedemption() {
    return request.resource.data.keys().hasOnly([
      'userId', 'userName', 'souvenirId', 'souvenirName', 'cost',
      'issuedByUid', 'issuedAt', 'status', 'mode'
    ])
    && request.resource.data.userId is string
    && request.resource.data.userId.size() > 0
    && request.resource.data.issuedByUid == request.auth.uid
    && request.resource.data.status == 'completed'
    && request.resource.data.mode == 'spark-ledger'
    && (
      (
        request.resource.data.souvenirId == 'tumbler'
        && request.resource.data.souvenirName == 'Eco-Friendly Tumbler'
        && request.resource.data.cost == 1000
      )
      || (
        request.resource.data.souvenirId == 'tote'
        && request.resource.data.souvenirName == 'CENRO Tote Bag'
        && request.resource.data.cost == 500
      )
      || (
        request.resource.data.souvenirId == 'kit'
        && request.resource.data.souvenirName == 'Reusable Utensil Kit'
        && request.resource.data.cost == 2000
      )
    );
  }

  function driverTruckAssignmentOnly() {
    return hasRole('driver')
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'currentTruckId', 'currentTruckPlate', 'assignedTruck', 'status', 'dutyStatus',
        'currentShiftFuelBudgetLiters', 'unassignedNotice', 'updatedAt'
      ])
      && (
        request.resource.data.get('currentTruckId', null) in [null, '']
        || get(/databases/$(database)/documents/trucks/$(request.resource.data.currentTruckId)).data.get('assignedDriverId', '') in [null, '', request.auth.uid]
      );
  }

  function cictoRoleUpdateOnly(userId) {
    return isCicto()
      && userId != request.auth.uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'department', 'designation', 'employeeId', 'status', 'updatedAt'])
      && request.resource.data.role in ['user', 'admin', 'cicto'];
  }

  function ownDriverLocation(locationId) {
    return hasRole('driver')
      && locationId == request.auth.uid
      && request.resource.data.get('driverId', '') == request.auth.uid;
  }

    // Diesel access uses explicit profile roles; coordinators are scoped to their barangay.
    function dieselManager() {
      return hasActiveProfile() && userProfile().role in ['admin', 'cenro', 'cenro_officer'];
    }
    function dieselCoordinator(barangay) {
      return hasRole('coordinator') && barangay is string && barangay.size() > 0
        && userProfile().get('assignedBarangay', userProfile().get('barangay', '')) == barangay;
    }
    function dieselReader(data) {
      return dieselManager()
        || data.get('status', '') == 'approved'
        || (hasRole('driver') && data.driverId == request.auth.uid)
        || dieselCoordinator(data.barangay);
    }
    function dieselScheduleReader(scheduleId) {
      let schedule = get(/databases/$(database)/documents/schedules/$(scheduleId)).data;
      return dieselManager() || (hasRole('driver') && schedule.assignedDriverId == request.auth.uid)
        || dieselCoordinator(schedule.barangay);
    }
    function validDieselIdentity(scheduleId) {
      let s = get(/databases/$(database)/documents/schedules/$(scheduleId)).data;
      let d = request.resource.data;
      return d.scheduleId == scheduleId && d.driverId == s.assignedDriverId
        && d.truckId == s.truckId && d.barangay == s.barangay && s.get('isLiveDispatch', false) == true;
    }
    function dieselNumber(value, minimum, maximum) {
      return value is number && value >= minimum && value <= maximum;
    }
    function validDieselActual() {
      let a = request.resource.data.actual;
      return a.keys().hasOnly(['distanceKm', 'drivingHours', 'idleHours', 'collectionHours', 'averageLoadPercent',
          'collectedKg', 'actualLiters', 'distanceSource', 'fuelMethod', 'evidence', 'isDemo', 'tripDate'])
        && dieselNumber(a.distanceKm, 0, 2000) && dieselNumber(a.drivingHours, 0, 24)
        && dieselNumber(a.idleHours, 0, 24) && dieselNumber(a.collectionHours, 0, 24)
        && a.drivingHours + a.idleHours + a.collectionHours > 0
        && a.drivingHours + a.idleHours + a.collectionHours <= 24
        && dieselNumber(a.averageLoadPercent, 0, 100) && dieselNumber(a.collectedKg, 0, 100000)
        && a.distanceSource in ['gps', 'odometer', 'manual']
        && a.isDemo is bool && a.tripDate is string && a.tripDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && a.evidence is string && a.evidence.size() <= 4000
        && ((a.actualLiters == null && a.fuelMethod == 'not-recorded')
          || (dieselNumber(a.actualLiters, 0.001, 2000) && a.fuelMethod in ['tank-balance', 'full-to-full', 'metered'] && a.evidence.size() > 0));
    }
    function dieselSubmission() {
      let d = request.resource.data;
      return d.keys().hasOnly(['scheduleId', 'driverId', 'truckId', 'barangay', 'actual', 'status', 'submittedBy',
          'submittedAt', 'reviewedAt', 'reviewedBy', 'reviewNote'])
        && d.status == 'pending' && d.submittedBy == request.auth.uid && d.submittedAt == request.time
        && d.reviewedAt == null && d.reviewedBy == null && d.reviewNote == '' && validDieselActual();
    }
    match /diesel_settings/{id} {
      allow read: if dieselManager() || hasRole('driver') || hasRole('coordinator');
      allow create, update: if dieselManager() && id == 'main'
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
        && dieselNumber(request.resource.data.parameters.pricePerLiter, 0.001, 1000)
        && dieselNumber(request.resource.data.parameters.kmPerLiter, 0.001, 30);
      allow delete: if false;
    }
    match /diesel_estimates/{scheduleId} {
      allow read: if dieselReader(resource.data);
      allow create: if dieselManager() && validDieselIdentity(scheduleId)
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /diesel_logs/{scheduleId} {
      // A missing document may be read by its assigned operator for duplicate-safe transactions.
      allow get: if dieselScheduleReader(scheduleId);
      allow list: if dieselReader(resource.data);
      allow create: if validDieselIdentity(scheduleId) && dieselReader(request.resource.data) && dieselSubmission();
      allow update: if (
        resource.data.status in ['pending', 'needs-correction']
        && validDieselIdentity(scheduleId) && dieselReader(resource.data) && dieselSubmission()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actual', 'status', 'submittedBy', 'submittedAt', 'reviewedAt', 'reviewedBy', 'reviewNote'])
      ) || (
        dieselManager() && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'needs-correction']
        && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewNote is string && request.resource.data.reviewNote.size() > 0 && request.resource.data.reviewNote.size() <= 4000
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewNote'])
      );
      allow delete: if false;
    }
    match /diesel_models/{truckId} {
      allow read: if dieselManager() || hasRole('driver') || hasRole('coordinator');
      allow create, update: if dieselManager() && request.resource.data.truckId == truckId
        && request.resource.data.trainedBy == request.auth.uid && request.resource.data.updatedAt == request.time
        && dieselNumber(request.resource.data.factor, 0.5, 2);
      allow delete: if false;
    }
    match /diesel_gps/{scheduleId}/points/{pointId} {
      allow read: if dieselScheduleReader(scheduleId);
      allow create: if hasRole('driver') && get(/databases/$(database)/documents/schedules/$(scheduleId)).data.assignedDriverId == request.auth.uid
        && request.resource.data.keys().hasOnly(['latitude', 'longitude', 'timestampMs', 'accuracyMeters', 'isSimulation', 'driverId', 'createdAt'])
        && request.resource.data.driverId == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.isSimulation == false
        && dieselNumber(request.resource.data.latitude, -90, 90) && dieselNumber(request.resource.data.longitude, -180, 180)
        && dieselNumber(request.resource.data.accuracyMeters, 0, 10000)
        && request.resource.data.timestampMs is number;
      allow update, delete: if false;
    }

    match /schedules/{scheduleId} {
      allow read: if isAdmin() || isCicto()
        || dieselCoordinator(resource.data.get('barangay', ''))
        || (isAuthenticated() && resource.data.userId == request.auth.uid)
        || (isAuthenticated() && resource.data.assignedDriverId == request.auth.uid)
        || isOwner(resource.data.get('userId', ''))
        || isAssignedDriver(resource.data)
        || (hasRole('driver') && resource.data.get('assignedDriverId', '') == request.auth.uid);
      allow create: if isAdmin() || isCicto()
        || (isAuthenticated() && (request.resource.data.assignedDriverId == request.auth.uid || request.resource.data.userId == request.auth.uid || hasRole('driver')));
      allow delete: if isAdmin() || isCicto();
      allow update: if isAdmin() || isCicto()
        || (
          (isAssignedDriver(resource.data) || (isAuthenticated() && (resource.data.assignedDriverId == request.auth.uid || resource.data.get('assignedDriverId', '') == request.auth.uid))
            || dieselCoordinator(resource.data.get('barangay', '')))
          && driverCompletionUpdateOnly()
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dieselClosedAt'])
            || (resource.data.get('isLiveDispatch', false) == true && request.resource.data.dieselClosedAt == request.time))
        );
    }

    match /barangay_schedules/{scheduleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /fleet_trips/{tripId} {
      allow read, write: if true;
    }

    match /client_activity/{activityId} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // SEC-06 FIX: Only verified drivers can write their own truck location.
    match /truck_locations/{driverId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isCicto() || (hasRole('driver') && driverId == request.auth.uid) || (isAuthenticated() && driverId == request.auth.uid);
    }

    match /trucks/{truckId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        hasRole('driver')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'assignedDriverId', 'assignedDriverName', 'shiftStartedAt', 'updatedAt'
        ])
        && (
          (
            (resource.data.get('assignedDriverId', null) in [null, ''] || resource.data.get('assignedDriverId', '') == request.auth.uid)
            && request.resource.data.get('assignedDriverId', '') == request.auth.uid
          )
          || (
            resource.data.get('assignedDriverId', '') == request.auth.uid
            && (request.resource.data.get('assignedDriverId', null) in [null, ''])
          )
        )
      );
    }

    // SEC-02 FIX: Removed naked isOwner(userId) from update rule.
    // Users can only modify their own profile through field-restricted functions.
    match /users/{userId} {
      allow create: if validResidentProfileCreate(userId) || validCictoProfileCreate(userId) || validAdminProfileCreate(userId) || isAdmin() || isCicto();
      allow read: if isOwner(userId) || isAdmin() || isCicto() || hasRole('coordinator') || resource.data.get('role', '') == 'driver';
      allow update: if isAdmin() || isCicto() || cictoRoleUpdateOnly(userId)
        || (isOwner(userId) && (regularProfileUpdateOnly() || driverTruckAssignmentOnly()));
      allow delete: if isAdmin() || isCicto();
    }

    match /mail/{mailId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin() || isCicto();
    }

    match /users/{userId}/devices/{deviceId} {
      allow read, create, update, delete: if isOwner(userId);
      allow read: if isAdmin();
    }

    match /identifiers/{document=**} {
      allow read, write: if isAdmin() || isCicto();
    }

    match /employee_ids/{employeeId} {
      allow read: if isAdmin() || isCicto();
      allow write: if isAdmin() || isCicto();
    }

    match /license_numbers/{licenseNumber} {
      allow read, write: if isAdmin() || isCicto();
    }

    match /coordinator_employee_ids/{employeeId} {
      allow read, write: if isAdmin() || isCicto();
    }

    match /user_settings/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // SEC-05 FIX: Restrict report reads to the creator, assigned driver, or admins.
    match /reports/{reportId} {
      allow create: if hasActiveProfile()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isAdmin() || isCicto()
        || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.get('userId', '') == request.auth.uid))
        || hasRole('driver')
        || (isAuthenticated() && (resource.data.assignedDriverId == request.auth.uid || resource.data.get('assignedDriverId', '') == request.auth.uid));
      allow update: if isAdmin() || isCicto()
        || (hasRole('driver') && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'assignedDriverId', 'assignedDriverName', 'assignedTruckPlate', 'queuedForDriver', 'dispatchedAt', 'updatedAt', 'collectedAt'
        ]))
        || (isAuthenticated() && (resource.data.assignedDriverId == request.auth.uid || resource.data.get('assignedDriverId', '') == request.auth.uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'assignedDriverId', 'assignedDriverName', 'assignedTruckPlate', 'queuedForDriver', 'dispatchedAt', 'updatedAt', 'collectedAt'
        ]));
      allow delete: if isAdmin() || isCicto();
    }

    match /client_activity/{activityId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin() || isCicto();
      allow update, delete: if isAdmin() || isCicto();
    }

    match /user_reports/{reportId} {
      allow create: if hasActiveProfile()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /driver_reports/{reportId} {
      allow create: if hasRole('driver')
        && (
          request.resource.data.driverId == request.auth.uid
          || request.resource.data.driverUid == request.auth.uid
          || request.resource.data.reportedByUid == request.auth.uid
        );
      allow read: if isAdmin()
        || (hasRole('driver') && (
          resource.data.driverId == request.auth.uid
          || resource.data.driverUid == request.auth.uid
          || resource.data.reportedByUid == request.auth.uid
        ));
      allow update, delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow create: if hasActiveProfile() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /feedbacks/{feedbackId} {
      allow create: if hasActiveProfile() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /collection_requests/{requestId} {
      allow create: if hasActiveProfile() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || resource.data.userId == request.auth.uid;
      allow update: if resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || resource.data.userId == request.auth.uid;
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy'])
      );
    }

    match /comments/{commentId} {
      allow create: if hasActiveProfile() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated();
      allow update, delete: if isAdmin() || resource.data.userId == request.auth.uid;
    }

    match /userNotifications/{notificationId} {
      allow create: if isAdmin()
        || (hasActiveProfile() && request.resource.data.userId == request.auth.uid);
      allow read: if resource.data.userId == request.auth.uid || isAdmin();
      allow update: if resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if isAdmin() || resource.data.userId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin() || resource.data.userId == request.auth.uid;
      allow update: if resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if isAdmin();
    }

    match /notifications/{userId}/messages/{notificationId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }


    match /proximity_alerts/{alertId} {
      allow read: if isAdmin() || resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /chat_logs/{userId} {
      allow read, create, update, delete: if isOwner(userId);
      allow read: if isAdmin();
    }

    match /chat_logs/{userId}/messages/{messageId} {
      allow read, create, update, delete: if isOwner(userId);
      allow read: if isAdmin();
    }

    match /user_locations/{userId} {
      allow read, create, update, delete: if isOwner(userId);
      allow read: if isAdmin();
    }

    match /waste_tracking/{userId} {
      allow read, create, update, delete: if isOwner(userId);
      allow read: if isAdmin();
    }

    match /waste_tracking/{userId}/entries/{entryId} {
      allow read, create, update, delete: if isOwner(userId);
      allow read: if isAdmin();
    }

    match /public_data/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /app_config/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /barangays/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_settings/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isCicto();
    }

    match /history/{historyId} {
      allow read, write: if isAdmin();
    }

    match /rewards/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isCicto();
    }

    match /reward_catalog/{catalogId} {
      allow read: if isAuthenticated();
      allow write: if isCicto() || isAdmin();
    }

    match /reward_redemptions/{redemptionId} {
      allow read: if isAdmin() || isCicto() || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.get('userId', '') == request.auth.uid));
      allow create: if (isAdmin() || isCicto()) && validRewardRedemption();
      allow update: if false;
      allow delete: if false;
    }

    match /interagency_messages/{messageId} {
      allow read: if isAdmin() || isCicto();
      allow create: if (isAdmin() || isCicto())
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderRole in ['cicto', 'cenro', 'admin']
        && request.resource.data.status == 'sent'
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 1
        && request.resource.data.subject.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 3000
        && request.resource.data.priority in ['normal', 'high', 'urgent'];
      allow update, delete: if false;
    }

    match /reward_awards/{awardId} {
      allow read: if isAdmin() || isCicto() || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.get('userId', '') == request.auth.uid));
      allow create: if isCicto() || isAdmin() || (
        hasActiveProfile()
        && awardId == 'report_' + request.resource.data.reportId
        && request.resource.data.tokens == 50
        && request.resource.data.reason == 'verified-collection-completed'
        && request.resource.data.createdByUid == request.auth.uid
        && get(/databases/$(database)/documents/schedules/$(request.resource.data.scheduleId)).data.reportId == request.resource.data.reportId
        && get(/databases/$(database)/documents/schedules/$(request.resource.data.scheduleId)).data.userId == request.resource.data.userId
        && get(/databases/$(database)/documents/schedules/$(request.resource.data.scheduleId)).data.status in ['completed', 'done']
        && get(/databases/$(database)/documents/schedules/$(request.resource.data.scheduleId)).data.collectionMeasurement.value is number
        && get(/databases/$(database)/documents/schedules/$(request.resource.data.scheduleId)).data.collectionMeasurement.value > 0
        && (
          hasRole('driver')
          && get(/databases/$(database)/documents/schedules/$(request.resource.data.scheduleId)).data.assignedDriverId == request.auth.uid
          && get(/databases/$(database)/documents/schedules/$(request.resource.data.scheduleId)).data.completedByUid == request.auth.uid
        )
      );
      allow update, delete: if false;
    }

    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    match /analytics/{document=**} {
      allow read: if isAdmin() || isCicto();
      allow write: if isAdmin();
    }

    match /error_logs/{document=**} {
      allow read: if isAdmin() || isCicto();
      allow write: if isAdmin();
    }

    // SEC-03 FIX: CICTO notifications and OTP verifications are restricted to CICTO admins only.
    match /cicto_notifications/{notificationId} {
      allow read, write: if isCicto();
    }

    match /cicto_otp_verifications/{verificationId} {
      allow read, write: if isCicto();
    }

    // Merged: audit_logs client-write rule (allows authenticated users to create audit entries)
    match /audit_logs/{logId} {
      allow read: if isAdmin() || isCicto();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /client_activity/{activityId} {
      allow read: if isAdmin() || isCicto();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
