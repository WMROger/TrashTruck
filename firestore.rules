// Firestore security rules
rules_version = '2';

service cloud.firestore {
  // Helpers
  function isAuthenticated() {
    return request.auth != null;
  }
  function isOwner(userId) {
    return request.auth != null && request.auth.uid == userId;
  }
  function isAdmin() {
    return isAuthenticated() && ('admin' in request.auth.token) && request.auth.token.admin == true;
  }
  // Driver assigned to a schedule
  function isAssignedDriver() {
    // Many docs store driver as an email or display name string
    return isAuthenticated() && (
      (('email' in request.auth.token) && resource.data.driver == request.auth.token.email) ||
      (('name' in request.auth.token) && resource.data.driver == request.auth.token.name) ||
      (('driverUid' in resource.data) && resource.data.driverUid == request.auth.uid)
    );
  }
  // Restrict what drivers can change when completing/flagging a pickup
  function driverCompletionUpdateOnly() {
    // Only these fields may change
    return resource.data.diff(request.resource.data).changedKeys().hasOnly([
      'status',
      'completedAt',
      'completionImage',
      'completionImagePublicId',
      'completionDescription',
      'completedBy',
      'completedByEmail',
      'completedByUid',
      'completedByName',
      'issueReportedAt',
      'issueImage',
      'issueImagePublicId',
      'issueDescription',
      'issueType',
      'reportedBy',
      'reportedByEmail',
      'reportedByUid',
      'reportedByName'
    ]);
  }
  function isValidCompletionStatus() {
    return request.resource.data.status in ['completed', 'issue'];
  }

  match /databases/{database}/documents {
    // Waste collection schedules
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isOwner(request.resource.data.userId) || isAdmin());
      // Admins and owners have full control; assigned drivers can only mark completion/issue with limited fields
      allow update: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        isAdmin() ||
        (isAssignedDriver() && driverCompletionUpdateOnly() && isValidCompletionStatus())
      );
      allow delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }
    // User profiles
    match /users/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      allow read, write: if isAdmin();
    }

    // User settings
    match /user_settings/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // Chat logs
    match /chat_logs/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      allow read: if isAdmin();
    }
    match /chat_logs/{userId}/messages/{messageId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      allow read: if isAdmin();
    }

  // ...existing code...

    // Collection requests
    match /collection_requests/{requestId} {
      allow read, write: if isAuthenticated() && isOwner(resource.data.userId);
      allow read, write: if isAdmin();
    }


    // Feedback (singular)
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Feedbacks (plural) - for admin dashboard
    match /feedbacks/{feedbackId} {
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Reports
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // User Reports (new collection)
    match /user_reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Relax reads for authenticated users so admin UI can list reports without custom claims
      allow read: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Driver Reports (new collection)
    match /driver_reports/{reportId} {
      // Allow any authenticated driver to create; document carries driver identifiers
      allow create: if isAuthenticated();
      // Relax reads for authenticated users so admin UI can list driver reports
      allow read: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow create: if isAdmin();
      allow read: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Comments on announcements
    match /comments/{commentId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Public data
    match /public_data/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // App configuration
    match /app_config/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Admin-only
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    // Analytics and logs
    match /analytics/{document=**} {
      allow read, write: if isAdmin();
    }
    match /error_logs/{document=**} {
      allow read, write: if isAdmin();
    }

    // Notifications
    match /notifications/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAdmin();
    }
    match /notifications/{userId}/messages/{notificationId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAdmin();
    }

    // User notifications (inbox)
    match /userNotifications/{notificationId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Locations
    match /user_locations/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      allow read: if isAdmin();
    }

    // Waste tracking
    match /waste_tracking/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      allow read: if isAdmin();
    }
    match /waste_tracking/{userId}/entries/{entryId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      allow read: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}